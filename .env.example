# --- Server Network ---
G3_PORT=8787
G3_S3_PORT=9000
G3_HOST=0.0.0.0

# --- SQLite & Storage Data ---
G3_DATA_DIR=./g3-data

# --- Default Admin Seed ---
G3_ADMIN_EMAIL=admin@g3.local
G3_ADMIN_PASSWORD=change-me-now

# --- Crypto ---
# Base64 32-byte key for AES-256-GCM token encryption (auto-generated if empty)
# Generate via: openssl rand -base64 32
G3_ENCRYPTION_KEY=

# --- Google Drive OAuth2 ---
# Dapatkan di Google Cloud Console (Drive API aktif)
G3_GOOGLE_CLIENT_ID=
G3_GOOGLE_CLIENT_SECRET=
G3_GOOGLE_REDIRECT_URI=http://localhost:8787/api/accounts/callback
