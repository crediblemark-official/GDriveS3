# --- Server Network ---
GDRIVES3_PORT=8787
GDRIVES3_S3_PORT=9000
GDRIVES3_S3_PUBLIC_URL=
GDRIVES3_HOST=0.0.0.0

# --- SQLite & Storage Data ---
GDRIVES3_DATA_DIR=./gdrives3-data

# --- Default Admin Seed ---
GDRIVES3_ADMIN_EMAIL=admin@gdrives3.local
GDRIVES3_ADMIN_PASSWORD=change-me-now

# --- Crypto ---
# Base64 32-byte key for AES-256-GCM token encryption (auto-generated if empty)
# Generate via: openssl rand -base64 32
GDRIVES3_ENCRYPTION_KEY=

# --- Google Drive OAuth2 ---
# Dapatkan di Google Cloud Console (Drive API aktif)
GDRIVES3_GOOGLE_CLIENT_ID=
GDRIVES3_GOOGLE_CLIENT_SECRET=
GDRIVES3_GOOGLE_REDIRECT_URI=http://localhost:8787/api/accounts/callback
