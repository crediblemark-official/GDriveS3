# --- GDriveS3 Sandbox / Local Development Environment ---
GDRIVES3_PORT=8787
GDRIVES3_S3_PORT=9000
GDRIVES3_HOST=0.0.0.0

GDRIVES3_DATA_DIR=./gdrives3-data
GDRIVES3_ADMIN_EMAIL=admin@gdrives3.local
GDRIVES3_ADMIN_PASSWORD=change-me-now

# Auto-generated on first run or supply base64 32-byte key
GDRIVES3_ENCRYPTION_KEY=

# Local Google OAuth Sandbox
GDRIVES3_GOOGLE_CLIENT_ID=sandbox-client-id.apps.googleusercontent.com
GDRIVES3_GOOGLE_CLIENT_SECRET=GOCSPX-sandbox-secret
GDRIVES3_GOOGLE_REDIRECT_URI=http://localhost:8787/api/accounts/callback
