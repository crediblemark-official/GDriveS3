# --- G3 Sandbox / Local Development Environment ---
G3_PORT=8787
G3_S3_PORT=9000
G3_HOST=0.0.0.0

G3_DATA_DIR=./g3-data
G3_ADMIN_EMAIL=admin@g3.local
G3_ADMIN_PASSWORD=change-me-now

# Auto-generated on first run or supply base64 32-byte key
G3_ENCRYPTION_KEY=

# Local Google OAuth Sandbox
G3_GOOGLE_CLIENT_ID=sandbox-client-id.apps.googleusercontent.com
G3_GOOGLE_CLIENT_SECRET=GOCSPX-sandbox-secret
G3_GOOGLE_REDIRECT_URI=http://localhost:8787/api/accounts/callback
