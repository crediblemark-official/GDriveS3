{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": {
      "@/*": ["panel/src/*"],
      "@server/*": ["server/*"]
    },
    "types": ["bun-types"]
  },
  "include": [
    "server/**/*",
    "panel/src/**/*",
    "panel/src/**/*.vue",
    "build.ts"
  ]
}
